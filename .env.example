# ============================================================================
# 3D Printer Slicer API - .env example
# ============================================================================
# Copy this file as .env and adjust values as needed.
# Credential values below are intentionally empty. Startup refuses to listen
# until all required non-slice actives and one complete slice mode are securely
# provisioned.

# ------------------------------
# Required settings
# ------------------------------
# Required non-slice active scoped keys and one complete slice-key mode.
# Generate distinct values through an operator-managed secret source; each must be
# 32-256 bytes of printable ASCII. Placeholder-like, malformed, missing, reused,
# or duplicate material is rejected generically. Slice accepts only
# x-slicer-api-key; pricing/artifact/operations accept only x-api-key.
#
# Slice startup accepts exactly one explicit fail-closed mode:
# - legacy (default): shared active required; named principals and slice expiry
#   must be empty;
# - migration: shared active plus both named principal actives required, with a
#   future SLICE_SERVICE_LEGACY_MIGRATION_UNTIL no more than 90 days away. At
#   that exact instant shared active/previous stop authorizing requests while
#   both principal families continue;
# - principals: both named principal actives required; shared active/previous
#   and slice expiry must be empty. This is the route-activation target mode.
# Previous slots are optional only when their own active exists. Any one-
# principal, mode/slot, duplicate, or expiry mismatch refuses startup.
SLICE_SERVICE_AUTH_MODE=legacy
SLICE_SERVICE_LEGACY_MIGRATION_UNTIL=
SLICE_SERVICE_API_KEY=
SLICE_SERVICE_WOOCOMMERCE_API_KEY=
SLICE_SERVICE_LEADPILOT_API_KEY=
PRICING_API_KEY=
ARTIFACT_API_KEY=
OPERATIONS_API_KEY=

# Optional previous rotation slots. During restart 1, set each changed family's
# previous slot to its former active key and active to the replacement. Move the
# caller, then remove that previous slot and perform restart 2 to revoke it.
SLICE_SERVICE_API_KEY_PREVIOUS=
SLICE_SERVICE_WOOCOMMERCE_API_KEY_PREVIOUS=
SLICE_SERVICE_LEADPILOT_API_KEY_PREVIOUS=
PRICING_API_KEY_PREVIOUS=
ARTIFACT_API_KEY_PREVIOUS=
OPERATIONS_API_KEY_PREVIOUS=

# Finite legacy ADMIN_API_KEY migration only. Normal operation leaves all three
# values empty and uses scoped keys above. To migrate exactly one non-slice
# audience, set its scoped active key empty, set AUDIENCE to pricing, artifact,
# or operations, supply a valid ADMIN_API_KEY, and use an ISO-8601 future expiry
# no more than 90 days away. Any configured valid ADMIN_API_KEY participates in
# global key uniqueness; only its exact authorized substitution for that missing
# scoped active avoids a duplicate self-registration. Expired/invalid/broad/
# slice migration fails startup.
ADMIN_API_KEY=
LEGACY_ADMIN_API_KEY_AUDIENCE=
LEGACY_ADMIN_API_KEY_MIGRATION_UNTIL=

# HTTP server port
PORT=3000

# Exact, comma-separated browser Origin allowlists per protected audience.
# Empty blocks browser-origin requests for that audience while allowing service
# clients that omit Origin. Cross-audience allowlists never grant access.
SLICE_CORS_ALLOWED_ORIGINS=
PRICING_CORS_ALLOWED_ORIGINS=
ARTIFACT_CORS_ALLOWED_ORIGINS=
OPERATIONS_CORS_ALLOWED_ORIGINS=

# Legacy one-audience CORS fallback used only while the finite ADMIN migration
# above is enabled for that same audience. Leave empty during normal operation.
ADMIN_CORS_ALLOWED_ORIGINS=


# ------------------------------
# Optional settings
# ------------------------------

# ------------------------------
# HTTP server envelope
# ------------------------------
# Invalid, empty, non-decimal, unsafe, or out-of-range values fall back to the
# defaults below. The effective headers timeout is also capped at request timeout.

# Header receive timeout in ms (bounded 1000..60000).
HTTP_HEADERS_TIMEOUT_MS=60000

# Request receive timeout in ms (bounded 60000..600000).
HTTP_REQUEST_TIMEOUT_MS=600000

# Keep-alive idle timeout in ms (bounded 1000..120000). Must stay above the
# reverse proxy's idle connection timeout toward the backend (Traefik default
# idleConnTimeout is 90 s), otherwise the proxy reuses a socket Node has closed.
HTTP_KEEP_ALIVE_TIMEOUT_MS=95000

# Maximum received header count (bounded 16..2000).
HTTP_MAX_HEADERS_COUNT=2000

# Maximum simultaneous HTTP connections (bounded 1..1024).
HTTP_MAX_CONNECTIONS=128

# Maximum requests accepted on one keep-alive socket (bounded 1..1000).
HTTP_MAX_REQUESTS_PER_SOCKET=100

# ------------------------------
# Body / Upload limits
# ------------------------------
# Express JSON body limit in bytes (strict integer, bounded 1024..10485760).
JSON_BODY_LIMIT=1048576

# Express URL-encoded/form body limit in bytes (strict integer, bounded 1024..10485760).
FORM_BODY_LIMIT=1048576

# Max upload file size in bytes (multipart)
# Example: 500 MB = 524288000 (500 * 1024 * 1024))
MAX_UPLOAD_BYTES=524288000

# Total multipart upload lifetime in ms (strict integer, bounded 1000..600000).
# Expiry returns HTTP 408 / UPLOAD_TOTAL_TIMEOUT and closes the connection.
UPLOAD_TOTAL_TIMEOUT_MS=600000

# Maximum number of non-file multipart fields (strict integer, bounded 35..64).
MULTIPART_MAX_FIELDS=40

# Maximum total multipart parts (strict integer, bounded 37..66). It must also
# allow configured fields plus one file and Busboy's terminating boundary.
MULTIPART_MAX_PARTS=42

# Maximum multipart field-name length in JavaScript characters (bounded 20..256).
MULTIPART_MAX_FIELD_NAME_CHARS=64

# Maximum bytes accepted for one multipart field value (bounded 1024..1048576).
MULTIPART_MAX_FIELD_BYTES=65536

# Multipart file count is fixed at 1 and field nesting depth is fixed at 0.
# Busboy 1.6.0 uses its internal fixed MAX_HEADER_PAIRS=2000 boundary; this API
# does not expose a header-pair override because Busboy does not consume one here.

# Audit threshold for marked job workspaces (ms, bounded 60000..2592000000).
# Startup is report-only; this setting cannot enable deletion.
JOB_WORKSPACE_STALE_AGE_MS=86400000

# ------------------------------
# Rate limiting
# ------------------------------
# Rate limit time window in ms
SLICE_RATE_LIMIT_WINDOW_MS=60000

# Number of allowed requests per IP in the time window
SLICE_RATE_LIMIT_MAX_REQUESTS=3

# Token bucket burst size for slicing endpoints (short burst allowance)
SLICE_RATE_LIMIT_BURST_CAPACITY=5

# Admin rate limit time window in ms
ADMIN_RATE_LIMIT_WINDOW_MS=60000

# Number of allowed admin requests per IP in the time window
ADMIN_RATE_LIMIT_MAX_REQUESTS=30

# ------------------------------
# Queue settings
# ------------------------------
# Maximum number of slice jobs running in parallel. Omission keeps the safe
# default 1. Explicit values must be canonical positive decimal 1..3; invalid
# values refuse startup. N=2 and N=3 are not yet host-qualified or deployed.
MAX_CONCURRENT_SLICES=1

# Maximum queue length
MAX_SLICE_QUEUE_LENGTH=100

# Maximum queued+active slice jobs per client IP
MAX_SLICE_QUEUE_PER_IP=5

# How long a request can wait in queue (ms)
MAX_SLICE_QUEUE_WAIT_MS=300000

# ------------------------------
# Archive, model, output, profile, pricing, and statistic guards
# ------------------------------
# All values below are canonical positive decimal integers. Invalid explicit
# values fail startup; they do not fall back to defaults.

# Maximum number of entries in ZIP, 3MF, SL1, or admin bulk sets (1..500).
MAX_ZIP_ENTRIES=500

# Maximum cumulative expanded/archive input size in bytes (1..524288000).
# Example: 500 MB = 524288000 (500 * 1024 * 1024)
MAX_ZIP_UNCOMPRESSED_BYTES=524288000

# Maximum expanded bytes for one archive entry (1..524288000).
MAX_ZIP_ENTRY_BYTES=524288000

# Maximum declared or actual compression ratio (1..1000).
MAX_ZIP_COMPRESSION_RATIO=100

# Maximum ZIP path depth (1..8); ordinary ZIP uploads default to root-only.
MAX_ZIP_PATH_DEPTH=1

# Maximum 3MF package-part path depth (2..8).
MAX_3MF_PATH_DEPTH=4

# Maximum model/intermediate and final output sizes in bytes (1..524288000).
MAX_MODEL_FILE_BYTES=524288000
MAX_OUTPUT_BYTES=524288000

# Maximum G-code text sampled for statistics (65536..16777216 bytes).
MAX_OUTPUT_PARSE_BYTES=4194304

# Maximum profile and pricing JSON/INI reads (1024..10485760 bytes).
MAX_PROFILE_BYTES=1048576
MAX_PRICING_BYTES=1048576

# Finite successful-stat and pricing ranges.
MAX_PRINT_TIME_SECONDS=2592000
MAX_MATERIAL_USED_METERS=10000
MAX_MATERIAL_USED_GRAMS=100000
MAX_MATERIAL_USED_ML=100000
MAX_HOURLY_PRICE_HUF=1000000
MAX_MODEL_DIMENSION_MM=10000

# ------------------------------
# Managed artifact retention and bounded cleanup
# ------------------------------
# Completed artifacts expire after this age (60000..2592000000 ms).
ARTIFACT_TTL_MS=86400000

# Maximum retained managed artifacts (1..5000) and cumulative bytes
# (1..5242880000). Oldest complete artifacts are evicted first.
MAX_MANAGED_ARTIFACTS=500
MAX_MANAGED_ARTIFACT_BYTES=524288000

# Incomplete artifact metadata/output cleanup threshold (60000..86400000 ms).
PARTIAL_ARTIFACT_STALE_MS=3600000

# Per-cleanup scan work limits: entries 1..5000 and time 100..10000 ms.
STARTUP_CLEANUP_MAX_ENTRIES=500
STARTUP_CLEANUP_MAX_MS=1000

# ------------------------------
# Slice command runtime
# ------------------------------
# External command timeout in ms (Prusa/Orca + model converters)
# Example: 10 minutes = 600000
SLICE_COMMAND_TIMEOUT_MS=600000

# Python preprocessing helper budget in ms (mesh2stl, cad2stl, orient,
# scale_model). Bounded 10000..SLICE_COMMAND_TIMEOUT_MS; invalid or
# out-of-range values fall back to the default (120000, capped at the
# native slice budget).
PYTHON_HELPER_TIMEOUT_MS=120000

# Fail closed when required print-time or filament-mass markers cannot be parsed
# from FDM G-code. Keep true; false exists only for bounded drift diagnosis.
SLICE_STRICT_GCODE_METRICS=true

# ------------------------------
# Orca profile overrides
# ------------------------------
# Machine profile filename (from configs/orca)
ORCA_MACHINE_PROFILE=Bambu_P1S_0.4_nozzle.json

# Process profile filenames by layerHeight (from configs/orca)
ORCA_PROCESS_PROFILE_0_1=FDM_0.1mm.json
ORCA_PROCESS_PROFILE_0_2=FDM_0.2mm.json
ORCA_PROCESS_PROFILE_0_3=FDM_0.3mm.json

# ------------------------------
# Proxy / client IP trust
# ------------------------------
# Forwarded identity is disabled by default. Set true only behind the exact
# trusted proxy peers listed below; malformed, duplicate, wildcard, overbroad,
# unknown-name, or missing trust entries make startup fail closed.
TRUST_PROXY=false

# Comma-separated explicit IPs/CIDRs or the single safe name "loopback".
# Example only: loopback,10.23.4.0/24,2001:db8:1234::/64
# Replace with the deployed reverse-proxy peers; do not copy example networks.
TRUST_PROXY_CIDRS=loopback

# ------------------------------
# Docker runtime identity, writable binds, and resource envelope
# ------------------------------
# Required for docker compose. Set these to the positive numeric UID/GID of the
# image's non-root slicer user and pre-create/chown the bind directories to the
# same identity with mode 0700.
SLICER_UID=
SLICER_GID=

# Host bind locations. Profiles/config root is mounted read-only; pricing state
# is overlaid as the only writable configs subtree.
SLICER_INPUT_DIR=./input
SLICER_OUTPUT_DIR=./output
SLICER_CONFIGS_DIR=./configs
SLICER_PRICING_STATE_DIR=./configs/pricing-state

# Compose resource envelope. Entrypoint validation accepts PID 64..512,
# memory 1073741824..8589934592 bytes, CPU 0.5..4.0 in 0.5 steps, log size
# 5m/10m/20m/50m, log files 1..5, and grace 10s/20s/30s/45s/60s.
SLICER_PIDS_LIMIT=512
SLICER_MEMORY_BYTES=4294967296
SLICER_CPU_LIMIT=2.0
SLICER_LOG_MAX_SIZE=20m
SLICER_LOG_MAX_FILES=5
SLICER_STOP_GRACE_PERIOD=30s

# ------------------------------
# Test scripts
# ------------------------------
# Base URL used by Python test runners
SLICER_BASE_URL=http://127.0.0.1:3000
