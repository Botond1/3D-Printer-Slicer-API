# The committed .disabled template is outside the mounted dynamic directory.
# Render only through scripts/i12-hostinger-operator-contract.js. It replaces
# the exact .invalid hostname and __J2_SOURCE_RANGES__ placeholder from private
# inputs.
http:
  routers:
    slicer-api:
      entryPoints:
        - websecure
      rule: "Host(`slicer-api.invalid`)"
      service: slicer-api
      middlewares:
        - slicer-api-source-allowlist
      tls:
        certResolver: letsencrypt
  middlewares:
    slicer-api-source-allowlist:
      ipAllowList:
        sourceRange:
          __J2_SOURCE_RANGES__
  services:
    slicer-api:
      loadBalancer:
        passHostHeader: true
        healthCheck:
          path: /ready
          interval: 10s
          timeout: 3s
        servers:
          - url: "http://3d-psa-backend-server:3000"
