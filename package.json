{
  "name": "3d-printer-slicer-api",
  "version": "3.1.4",
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "dev": "node --watch app/server.js",
    "test": "npm run test:js && npm run test:python",
    "test:js": "node scripts/run-js-tests.js",
    "test:python": "node scripts/run-python.js -m unittest discover -s tests/unit/python -p \"test_*.py\"",
    "check:syntax": "npm run check:syntax:js && npm run check:syntax:python",
    "check:syntax:js": "node scripts/validate-js-syntax.js",
    "check:syntax:python": "node scripts/run-python.js scripts/validate-python-syntax.py",
    "check:repository-safety": "node scripts/run-python.js scripts/validate-repository-safety.py --scope tracked",
    "check:repository-safety:staged": "node scripts/run-python.js scripts/validate-repository-safety.py --scope staged"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "swagger-ui-express": "^5.0.0",
    "yauzl": "^3.2.0"
  }
}
